# 서버 포트 (기본 9000)
PORT=9000

# ----------------------------------------
# LLM 설정
# ----------------------------------------
# claude | gemini (기본 claude)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 모델 오버라이드 (선택, 아래는 기본값)
# CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
# CLAUDE_MODEL_SMART=claude-sonnet-4-6
# GEMINI_MODEL_FAST=gemini-3.1-flash-lite
# GEMINI_MODEL_SMART=gemini-3.5-flash

# ----------------------------------------
# Semantic Scholar (paper_analyzer, 레이트리밋 완화)
# ----------------------------------------
S2_API_KEY=

# ----------------------------------------
# Supabase (히스토리 + 인증)
# ----------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# ----------------------------------------
# 인증 쿠키 (선택, 미설정 시 https 여부로 자동 판단)
# ----------------------------------------
